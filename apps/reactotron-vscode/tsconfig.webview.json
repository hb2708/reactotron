{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "../..",
    "baseUrl": ".",
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "electron": ["./webview/shims/electron.ts"],
      "electron-store": ["./webview/shims/electron-store.ts"],
      "reactotron-core-server": ["./webview/shims/reactotron-core-server.ts"],
      "reactotron-mcp": ["./webview/shims/reactotron-mcp.ts"],
      "fs": ["./webview/shims/fs.ts"],
      "path": ["./webview/shims/path.ts"],
      "os": ["./webview/shims/os.ts"],
      "events": ["./webview/shims/events.ts"]
    }
  },
  "include": ["webview"]
}
