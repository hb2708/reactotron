{
  "name": "reactotron-vscode",
  "displayName": "Reactotron",
  "description": "Drop-in Reactotron desktop inspector inside VS Code & Cursor powered by a dedicated worker thread",
  "version": "0.1.4",
  "publisher": "hb2708",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hb2708/reactotron.git"
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Debuggers"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "reactotron.open",
        "title": "Reactotron: Open Inspector"
      },
      {
        "command": "reactotron.restart",
        "title": "Reactotron: Restart Server"
      },
      {
        "command": "reactotron.toggleBindMode",
        "title": "Reactotron: Toggle LAN / Loopback Bind Mode"
      }
    ],
    "configuration": {
      "title": "Reactotron",
      "properties": {
        "reactotron.port": {
          "type": "number",
          "default": 9090,
          "description": "WebSocket server port for Reactotron clients."
        },
        "reactotron.bindHost": {
          "type": "string",
          "enum": [
            "0.0.0.0",
            "127.0.0.1"
          ],
          "default": "0.0.0.0",
          "description": "Network interface to bind (0.0.0.0 for Expo/LAN devices, 127.0.0.1 for strict loopback)."
        },
        "reactotron.maxPayloadMB": {
          "type": "number",
          "default": 5,
          "description": "Maximum single WebSocket message size in megabytes before truncation."
        },
        "reactotron.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start the Reactotron WebSocket server on VS Code startup."
        }
      }
    }
  },
  "scripts": {
    "clean": "rimraf ./dist",
    "build:ext": "tsc --noEmit -p tsconfig.json && node scripts/build-ext.mjs",
    "build:webview": "tsc --noEmit -p tsconfig.webview.json && vite build",
    "build": "yarn build:ext && yarn build:webview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.webview.json",
    "test": "node test/worker.test.mjs",
    "package": "yarn build && vsce package --no-dependencies"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.28",
    "color-interpolate": "1.0.5",
    "immer": "^10.0.3",
    "lodash.debounce": "^4.0.8",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hotkeys": "^2.0.0",
    "react-icons": "^4.11.0",
    "react-modal": "3.16.1",
    "react-motion": "0.5.2",
    "react-router-dom": "^6.18.0",
    "react-tooltip": "4.5.1",
    "reactotron-core-contract": "workspace:*",
    "reactotron-core-ui": "workspace:*",
    "reactotron-mcp": "workspace:*",
    "styled-components": "^6.1.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^20.11.30",
    "@types/react": "18.2.45",
    "@types/react-dom": "18.2.14",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.5.8",
    "@vitejs/plugin-react": "^4.3.4",
    "@vscode/vsce": "^2.32.0",
    "esbuild": "^0.21.5",
    "rimraf": "^5.0.5",
    "typescript": "^5.1.3",
    "vite": "^5.4.11"
  }
}
